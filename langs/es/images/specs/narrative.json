{
 "event/demo1.pck": {
  "story_00.webp": {
   "estilo": "story",
   "texto": "Asgard, el reino de los dioses."
  },
  "story_00_1.webp": {
   "estilo": "story",
   "texto": "Utgard, el hogar de los demonios."
  },
  "story_01.webp": {
   "estilo": "story",
   "texto": "Hace mucho tiempo estalló una guerra"
  },
  "story_01_1.webp": {
   "estilo": "story",
   "texto": "entre dioses y demonios: el Ragnarok…"
  },
  "story_02.webp": {
   "estilo": "story",
   "texto": "…y el mundo fue arrojado"
  },
  "story_02_1.webp": {
   "estilo": "story",
   "texto": "a un estado de caos."
  },
  "story_03.webp": {
   "estilo": "story",
   "texto": "Asgard, invadido por los demonios,"
  },
  "story_03_1.webp": {
   "estilo": "story",
   "texto": "estaba al borde de la destrucción."
  },
  "story_04.webp": {
   "estilo": "story",
   "texto": "Desesperados, los dioses rompieron un viejo tabú."
  },
  "story_04_1.webp": {
   "estilo": "story",
   "texto": "Sacrificando sus propias vidas…"
  },
  "story_05.webp": {
   "estilo": "story",
   "texto": "…crearon segadores de alas negras"
  },
  "story_05_1.webp": {
   "estilo": "story",
   "texto": "a los que se conocería como Ángeles de la Muerte."
  },
  "story_06.webp": {
   "estilo": "story",
   "texto": "Cada uno con un arma divina llamada «Diviner»,"
  },
  "story_06_1.webp": {
   "estilo": "story",
   "texto": "los ángeles entraron en batalla…"
  },
  "story_07.webp": {
   "estilo": "story",
   "texto": "Gracias a su feroz resistencia,"
  },
  "story_07_1.webp": {
   "estilo": "story",
   "texto": "los ángeles pusieron fin a la guerra."
  },
  "story_08.webp": {
   "estilo": "story",
   "texto": "Los demonios fueron sellados,"
  },
  "story_08_1.webp": {
   "estilo": "story",
   "texto": "pero los dioses pronto los seguirían."
  },
  "story_09.webp": {
   "estilo": "story",
   "texto": "Los dioses dejaron su poder y su saber"
  },
  "story_09_1.webp": {
   "estilo": "story",
   "texto": "en la isla celestial de Riviera…"
  },
  "story_10.webp": {
   "estilo": "story",
   "texto": "la Tierra Prometida,"
  },
  "story_10_1.webp": {
   "estilo": "story",
   "texto": "confiándola a los espíritus hasta su regreso."
  },
  "story_11.webp": {
   "estilo": "story",
   "texto": "Han pasado 1000 años"
  },
  "story_11_1.webp": {
   "estilo": "story",
   "texto": "desde el ocaso de los dioses…"
  },
  "story_12.webp": {
   "estilo": "story",
   "texto": "Las señales del regreso de los demonios"
  },
  "story_12_1.webp": {
   "estilo": "story",
   "texto": "han llevado el miedo a esta tierra apacible."
  },
  "story_13.webp": {
   "estilo": "story",
   "texto": "Sin los dioses,"
  },
  "story_13_1.webp": {
   "estilo": "story",
   "texto": "Asgard no resistiría otra guerra."
  },
  "story_14.webp": {
   "estilo": "story",
   "texto": "Y así, los 7 Magi, enviados de los dioses,"
  },
  "story_14_1.webp": {
   "estilo": "story",
   "texto": "tomaron una decisión…"
  },
  "story_15.webp": {
   "estilo": "story",
   "texto": "Activarán la Retribución,"
  },
  "story_15_1.webp": {
   "estilo": "story",
   "texto": "liberando el poder que hay en Riviera."
  },
  "story_16.webp": {
   "estilo": "story",
   "texto": "Los Magi eligieron a los agentes más poderosos"
  },
  "story_16_1.webp": {
   "estilo": "story",
   "texto": "para llevar a cabo su plan:"
  },
  "story_17.webp": {
   "estilo": "story",
   "texto": "ángeles de la muerte de alas negras con Diviners,"
  },
  "story_17_1.webp": {
   "estilo": "story",
   "texto": "los Ángeles de la Muerte…"
  },
  "story_18.webp": {
   "estilo": "story",
   "texto": "…renacidos"
  },
  "story_18_1.webp": {
   "estilo": "story",
   "texto": "por primera vez en 1000 años."
  },
  "story_19.webp": {
   "estilo": "story",
   "texto": "Ahora, dos ángeles descenderán"
  },
  "story_20.webp": {
   "estilo": "story",
   "texto": "sobre el suelo sagrado de Riviera…"
  },
